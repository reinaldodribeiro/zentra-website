# Copie para .env.local para testar o envio real em localhost:3000.
# Em produção, as duas moram só no projeto da Vercel (Settings, Environment Variables).
# Nunca coloque valores aqui: este repositório é espelhado para um repositório público.

# Chave da Resend. Envia o formulário de contato para contato@zentrabusiness.com.br
# e cria o assinante da newsletter. Sem ela, contato e newsletter respondem 503.
RESEND_API_KEY=

# Id da lista (segmento) da Resend que recebe os assinantes da newsletter.
# Sem ela, só a newsletter responde 503.
RESEND_AUDIENCE_ID=

# Código de verificação do Google Search Console (conteúdo da meta tag google-site-verification).
# Público por natureza, mas mora só no projeto da Vercel. Sem ele, a meta não sai.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
