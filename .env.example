# Copie para .env.local para testar o envio real em localhost:3000.
# Em produção, as duas moram só no projeto da Vercel (Settings, Environment Variables).
# Nunca coloque valores aqui: este repositório é espelhado para um repositório público.

# Chave da Resend. Envia o formulário de contato para contato@zentrabusiness.com.br
# e cria o assinante da newsletter. Sem ela, contato e newsletter respondem 503.
RESEND_API_KEY=

# Id da lista (segmento) da Resend que recebe os assinantes da newsletter.
# Sem ela, só a newsletter responde 503.
RESEND_AUDIENCE_ID=

# Código de verificação do Google Search Console (conteúdo da meta tag google-site-verification).
# Público por natureza, mas mora só no projeto da Vercel. Sem ele, a meta não sai.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Endereço da lista de documentos legais que o site busca no servidor, sem barra no fim.
# Sem ela, o site busca a ponte pública do sistema em produção. Para testar com o sistema local,
# por exemplo: http://localhost:3000/api/legal/documents (rode o site em outra porta).
LEGAL_DOCUMENTS_URL=

# Medição de uso, só carrega depois de o visitante aceitar a categoria análise no aviso de cookies.
# A chave do PostHog (phc_...) e o ID do Google Analytics (G-...) são públicos por natureza, mas moram
# só no projeto da Vercel. Sem a chave ou sem o ID, nada é carregado. O host padrão é o da região UE.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
